{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OfflineScribe encounter",
  "type": "object",
  "required": ["encounter_id", "transcript", "gold_note"],
  "properties": {
    "encounter_id": { "type": "string" },
    "specialty": { "type": "string" },
    "transcript": { "type": "string" },
    "gold_note": {
      "type": "object",
      "properties": {
        "subjective": { "type": "string" },
        "objective": { "type": "string" },
        "assessment": { "type": "string" },
        "plan": { "type": "string" }
      }
    },
    "gold_meds": { "type": "array", "items": { "type": "string" } },
    "gold_entities": { "type": "array", "items": { "type": "string" } },
    "planted": { "type": "array", "items": { "type": "object" } }
  }
}
