# Copy this file to `.env` and fill in values. Never commit `.env`.

# --- App ---
# STUB_MODE=true returns a canned SOAP note (fast tests, no Ollama).
# STUB_MODE=false calls the local Ollama model with the real transcript.
STUB_MODE=true
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# SQLCipher passphrase for the local visit database. Never commit a real clinic key.
# Must come from the environment or this file. Empty values and example
# placeholders (changeme, local-dev-only-*) fail startup.
# Changing this cannot decrypt an existing file — delete backend/data/offline_scribe.db
# and let the app recreate it.
SQLCIPHER_KEY=

# Shared secret for the localhost API (every route except /health).
# The desktop app must send the same value as X-API-Key (see VITE_LOCAL_API_KEY).
# Empty values and example placeholders fail startup.
LOCAL_API_KEY=

# Tests set this true. Leave false for a supervised pilot so leftover
# STUB_MODE=true development defaults refuse to start.
ALLOW_DEV_DEFAULTS=false

# Delete visits older than this many days on API startup. 0 disables purge.
VISIT_RETENTION_DAYS=0

# --- Local models ---
# ASR runs even when STUB_MODE=true. STUB_MODE only skips the local LLM.
ASR_MODEL_SIZE=small.en
ASR_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Reject uploads larger than this (bytes). Default 100 MiB.
MAX_UPLOAD_BYTES=104857600

OLLAMA_HOST=http://127.0.0.1:11434
# Config default. On an 8GB CPU Mac, llama3:8b completed evaluation notes
# in minutes; llama3.1:8b was ~0.09 tok/s and timed out. Change locally if needed.
OLLAMA_MODEL=llama3.1:8b
# SOAP generation can exceed the 120s default on CPU-only 8B models.
# OLLAMA_TIMEOUT_SECONDS=1200

# Load Whisper when the API starts. Tests set this false.
# ASR_PRELOAD=true

# --- Oracle Health / Cerner sandbox ---
# Register a *System* application in code Console, then paste the system
# account client id and secret here. See README: Connecting to Oracle Health's Sandbox.
USE_SANDBOX=true
CERNER_CLIENT_ID=
CERNER_CLIENT_SECRET=

# Public sandbox tenant (documented). Change these only when moving to another tenant.
FHIR_BASE_URL=https://fhir-ehr-code.cerner.com/r4/ec2458f2-1e24-41c8-b71b-0e701af7583d
TENANT_ID=ec2458f2-1e24-41c8-b71b-0e701af7583d
OAUTH_SCOPES=system/DocumentReference.write system/DocumentReference.read system/Patient.read system/Encounter.read

# DocumentReference.author only. Do not use example Patient/Encounter ids as
# defaults — each visit must be linked explicitly or sync will skip it.
# TODO: verify this practitioner id is valid on the target tenant.
FHIR_PRACTITIONER_ID=3332064
