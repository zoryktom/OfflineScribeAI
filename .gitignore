# Secrets — keep committed *.env.example files only
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key

# Local databases (may contain PHI once real visits exist)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Runtime data: SQLCipher DB, Whisper cache — not source
backend/data/

# Logs and leftover debug / dry-run dumps
*.log
logs/
*.dry-run.json
dry_run*.json
debug/

# Review packets and pasted notes (not product source)
REVIEW_PACKET.md
**/*REVIEW_PACKET*
**/*review-notes*

# Ablation outputs (keep configs)
experiments/runs/**
!experiments/runs/.gitkeep
data/audit/*.jsonl
!data/audit/.gitkeep

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Vite / Tauri
node_modules/
dist/
build/
desktop-app/dist/
desktop-app/src-tauri/target/
desktop-app/src-tauri/gen/

# Synthetic / recorded audio — keep the .txt scripts.
# english_speech_sample.wav is a short synthetic fixture required by ASR tests.
audio_samples/*.wav
!audio_samples/english_speech_sample.wav

# OS / editor / local agent
.DS_Store
.idea/
.vscode/
.cursor/
*.swp
*~
*.canvas.tsx
